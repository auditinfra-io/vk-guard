{
  "name": "vk-guard",
  "version": "0.3.0",
  "description": "Verification-key and constraint-count regression guard for o1js zkApps. Fails CI when a circuit's verification key or constraint counts drift from a committed baseline.",
  "keywords": [
    "o1js",
    "mina",
    "zkapp",
    "verification-key",
    "regression",
    "ci",
    "constraint-count",
    "zk"
  ],
  "license": "MIT",
  "author": "auditinfra-io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auditinfra-io/vk-guard.git"
  },
  "homepage": "https://github.com/auditinfra-io/vk-guard#readme",
  "bugs": {
    "url": "https://github.com/auditinfra-io/vk-guard/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vk-guard": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "example:check": "node dist/cli.js check --root examples/counter --snapshot examples/counter/.vk-guard.json",
    "experiments": "npm run experiments:build && node experiments/.build/determinism.js && node experiments/.build/cache-correctness.js",
    "experiments:build": "tsc -p experiments/tsconfig.json"
  },
  "packageManager": "npm@10",
  "peerDependencies": {
    "o1js": ">=3.0.0 <4.0.0"
  },
  "dependencies": {
    "tinyglobby": "^0.2.10",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "o1js": "^3.0.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}
